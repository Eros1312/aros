# Configuration reference. The local demo sets safe values itself.
# For a server, use scripts/prepare_env.py to create private deploy/.env.
APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./aros.db
PUBLIC_ORIGIN=http://127.0.0.1:8000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ENCRYPTION_KEY=
WEB_DIR=../web/out
SESSION_DAYS=7

# Optional. Leave blank for the local no-provider mode.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENCLAW_URL=
OPENCLAW_TOKEN=
OPENCLAW_MODEL=
OPENCLAW_DESIGN_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FREELLM_URL=
FREELLM_TOKEN=
FREELLM_MODELS=
SERVER_AGENT_URL=
SERVER_AGENT_TOKEN=
RSS_URLS=
