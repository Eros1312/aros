# prepare_env.py generates secrets locally; never commit .env
AROS_DOMAIN=aros.example.com
APP_ENV=production
DEMO_MODE=false
PUBLIC_ORIGIN=https://aros.example.com
ADMIN_EMAIL=aros@local
ADMIN_PASSWORD=GENERATE_WITH_PREPARE_ENV
POSTGRES_PASSWORD=GENERATE_WITH_PREPARE_ENV
DATABASE_URL=postgresql+psycopg://aros:GENERATE_WITH_PREPARE_ENV@database:5432/aros
ENCRYPTION_KEY=GENERATE_WITH_PREPARE_ENV
WEB_DIR=/web/out
SESSION_DAYS=7
# Optional providers. Secrets stay on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENCLAW_URL=
OPENCLAW_TOKEN=
OPENCLAW_MODEL=
OPENCLAW_DESIGN_MODEL=
RSS_URLS=
SERVER_AGENT_URL=
SERVER_AGENT_TOKEN=

# FreeLLMAPI private router (initialized by scripts)
FREELLM_URL=
FREELLM_TOKEN=
FREELLM_MODELS=
FREELLM_ENCRYPTION_KEY=
FREELLM_ADMIN_PASSWORD=
