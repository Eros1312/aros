        "workspace": "/home/node/.openclaw/workspaces/aros-planner",
        "model": {
          "primary": "CONFIGURE_EXPLICIT_MODEL",
          "fallbacks": []
        },
        "utilityModel": "CONFIGURE_EXPLICIT_MODEL",
        "decisionModel": "CONFIGURE_EXPLICIT_MODEL",
        "modelPolicy": {
          "allow": [
            "CONFIGURE_EXPLICIT_MODEL"
          ]
        },
        "tools": {
          "allow": [
            "session_status"
          ]
        },
        "skills": []
      }
    }
  },
  "tools": {
    "deny": [],
    "elevated": {
      "enabled": false
    },
    "allow": [
      "aros_resources",
      "aros_prepare_action",
      "session_status"
    ]
  },
  "plugins": {
    "entries": {
      "memory-core": {
        "enabled": false
      },
      "admin-http-rpc": {
        "enabled": true
      },
      "whatsapp": {
        "enabled": false
      },
      "aros-tools": {
        "enabled": true
      }
    },
    "slots": {
      "memory": "none"
    },
    "load": {
      "paths": [
        "/home/node/aros-tools",
        "/usr/local/lib/node_modules/@openclaw/whatsapp"
      ]
    }
  },
  "channels": {
    "whatsapp": {
      "enabled": false,
      "dmPolicy": "allowlist",
      "allowFrom": [],
      "selfChatMode": true,
      "groupPolicy": "disabled",
      "sendReadReceipts": false
    }
  },
  "bindings": [
    {
      "agentId": "aros",
      "match": {
        "channel": "whatsapp",
        "accountId": "default"
      }
    }
  ],
  "session": {
    "dmScope": "per-channel-peer"
  }
}
