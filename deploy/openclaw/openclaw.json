{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "CONFIGURE_EXPLICIT_MODEL",
        "fallbacks": []
      },
      "models": {
        "CONFIGURE_EXPLICIT_MODEL": {}
      },
      "modelPolicy": {
        "allow": [
          "CONFIGURE_EXPLICIT_MODEL"
        ]
      },
      "thinkingDefault": "low",
      "authInheritance": {
        "agentId": "aros"
      }
    },
    "ownership": "explicit",
    "entries": {
      "aros": {
        "name": "Aros",
        "workspace": "/home/node/.openclaw/workspaces/aros",
        "model": {
          "primary": "CONFIGURE_EXPLICIT_MODEL",
          "fallbacks": []
        },
        "utilityModel": "CONFIGURE_EXPLICIT_MODEL",
        "decisionModel": "CONFIGURE_EXPLICIT_MODEL",
        "modelPolicy": {
          "allow": [
            "CONFIGURE_EXPLICIT_MODEL"
          ]
        },
        "tools": {
          "allow": [
            "aros_resources",
            "aros_prepare_action"
          ]
        }
      },
      "university": {
        "name": "Universidad",
        "workspace": "/home/node/.openclaw/workspaces/university",
        "model": {
          "primary": "CONFIGURE_EXPLICIT_MODEL",
          "fallbacks": []
        },
        "utilityModel": "CONFIGURE_EXPLICIT_MODEL",
        "decisionModel": "CONFIGURE_EXPLICIT_MODEL",
        "modelPolicy": {
          "allow": [
            "CONFIGURE_EXPLICIT_MODEL"
          ]
        },
        "tools": {
          "allow": [
            "aros_resources",
            "aros_prepare_action"
          ]
        }
      },
      "prisma": {
        "name": "PRISMA",
        "workspace": "/home/node/.openclaw/workspaces/prisma",
        "model": {
          "primary": "CONFIGURE_EXPLICIT_MODEL",
          "fallbacks": []
        },
        "utilityModel": "CONFIGURE_EXPLICIT_MODEL",
        "decisionModel": "CONFIGURE_EXPLICIT_MODEL",
        "modelPolicy": {
          "allow": [
            "CONFIGURE_EXPLICIT_MODEL"
          ]
        },
        "tools": {
          "allow": [
            "aros_resources",
            "aros_prepare_action"
          ]
        }
      },
      "technology": {
        "name": "IA y Tecnología",
        "workspace": "/home/node/.openclaw/workspaces/technology",
        "model": {
          "primary": "CONFIGURE_EXPLICIT_MODEL",
          "fallbacks": []
        },
        "utilityModel": "CONFIGURE_EXPLICIT_MODEL",
        "decisionModel": "CONFIGURE_EXPLICIT_MODEL",
        "modelPolicy": {
          "allow": [
            "CONFIGURE_EXPLICIT_MODEL"
          ]
        },
        "tools": {
          "allow": [
            "aros_resources",
            "aros_prepare_action"
          ]
        }
      },
      "printing": {
        "name": "Impresión 3D",
        "workspace": "/home/node/.openclaw/workspaces/printing",
        "model": {
          "primary": "CONFIGURE_EXPLICIT_MODEL",
